{
    "name": "techrappy/techrappy-seo",
    "description": "Plugin WordPress SEO avec Divi Builder + OpenAI",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "TechrappySEO\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test-coverage": "phpunit --configuration phpunit.xml.dist --coverage-text"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
